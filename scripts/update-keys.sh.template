#!/usr/bin/env bash
# Copy to scripts/update-keys.sh and fill in (gitignored — never commit).
# Sourced by scripts/release.sh for deploy credentials.
#
# Normal workflow (one step):
#   npm run release
#
#   cp scripts/update-keys.sh.template scripts/update-keys.sh
#   chmod 600 scripts/update-keys.sh

export UPDATE_MANIFEST_DEPLOY_HOST=
export UPDATE_MANIFEST_DEPLOY_USER=
# Webroot for https://apps.codemacher.de/dmarc-lighthouse/updates/
# e.g. /var/docker/apps-php/www/dmarc-lighthouse/updates
export UPDATE_MANIFEST_DEPLOY_PATH=
# Path to SSH *private* key (not .pub), or leave empty to use ssh-agent
export UPDATE_MANIFEST_DEPLOY_KEY=
# export UPDATE_MANIFEST_DEPLOY_PORT=22

# Optional: old TYPO3 path — used only by --retire-legacy (301 + delete old files)
# export UPDATE_MANIFEST_LEGACY_DEPLOY_PATH=/var/docker/typo3/www/public/dmarc-lighthouse/updates

# Optional: local Ed25519 signing key if CI did not attach *.json / *.json.sig
# export UPDATE_SIGNING_PRIVATE_KEY_FILE=keys/update-ed25519-private.pem

# Running this file directly = same as: npm run release -- --deploy-only
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  set -euo pipefail
  cd "$(dirname "$0")/.."
  exec bash scripts/release.sh --deploy-only "$@"
fi
