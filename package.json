{
  "name": "dmarc-lighthouse",
  "version": "1.0.32",
  "description": "DMARC Lighthouse — desktop app for IMAP/OAuth fetch, SQLite cache, aggregate and forensic DMARC analysis",
  "main": "./out/main/index.js",
  "author": "codemacher UG (haftungsbeschränkt)",
  "license": "MIT",
  "homepage": "https://codemacher.de/",
  "repository": {
    "type": "git",
    "url": "https://github.com/codemacherUG/dmarc-lighthouse.git"
  },
  "desktopName": "dmarc-lighthouse.desktop",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "update:keys": "node scripts/update-keys.mjs",
    "update:sign": "node scripts/sign-update-manifest.mjs",
    "update:deploy": "node scripts/deploy-update-manifest.mjs",
    "release": "bash scripts/release.sh",
    "screenshots": "electron-vite dev -- --capture-screenshots",
    "screenshot:full": "electron-vite dev -- --capture-full-app",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:release": "npm run build && electron-builder --win --linux --mac"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@koduhai/dmarc-parser": "^0.2.1",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "imapflow": "^1.6.5",
    "leaflet": "^1.9.4",
    "maxmind": "^5.0.7",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/maxmind": "^2.0.4",
    "@types/node": "^24.13.3",
    "@types/tar": "^6.1.13",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.7.4",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron": true
  }
}
